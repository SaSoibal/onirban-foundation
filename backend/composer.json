{
    "name": "onirban-foundation/backend",
    "type": "project",
    "description": "Onirban Foundation Laravel Backend API",
    "keywords": ["laravel", "sanctum", "spatie", "permission", "api"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "intervention/image": "^2.7",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "nunomaduro/collision": "^8.0",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "1.29.3",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php artisan test"
        ],
        "lint": [
            "./vendor/bin/pint --test"
        ],
        "fix": [
            "./vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "laravel/pint": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "platform": {
            "php": "8.2.33"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
